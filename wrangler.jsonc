{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opensync",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/server.js",
  "assets": {
    "directory": "dist/client"
  },
  "routes": [
    { "pattern": "opensync.com.br/*", "zone_name": "opensync.com.br" },
    { "pattern": "www.opensync.com.br/*", "zone_name": "opensync.com.br" }
  ],
  "vars": {
    "SUPABASE_URL": "https://zmwvcdvliifebehkyoos.supabase.co",
    "ASAAS_ENV": "production",
    "PUBLIC_SITE_URL": "https://opensync.com.br"
  }
}
